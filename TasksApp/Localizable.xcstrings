      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "A label that describes the time picker. The argument is the string “%1$arg, %2$arg · %3$arg” or the string “%1$arg · %2$arg”.",
